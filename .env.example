# Copy to .env (optional) and export, e.g.:  set -a; source .env; set +a
# GBIF needs no API key for occurrence search.
GBIF_BASE_URL=https://api.gbif.org/v1/occurrence/search
GBIF_COUNTRY=KZ
GBIF_YEAR_FROM=2015
GBIF_YEAR_TO=2025
GBIF_RECORDS_PER_MONTH=8
GBIF_MAX_RANDOM_OFFSET=3000
GBIF_RANDOM_SEED=42
GBIF_WORKERS=4

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=gbif-kz-occurrences
KAFKA_TOPIC_PARTITIONS=3
KAFKA_CONSUMER_GROUP=sis2-gbif-consumer
KAFKA_CONSUMER_IDLE_TIMEOUT_S=10

SQLITE_DB_PATH=data/output.db
